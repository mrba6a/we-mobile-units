{
  "name": "we-mobile-units",
  "version": "1.0.0",
  "private": true,
  "description": "WE Mobile Units Management System - Multi-app Monorepo",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:worker": "turbo run build --filter=@we/worker-api",
    "build:apps": "turbo run build --filter=@we/we-shell --filter=@we/we-review --filter=@we/we-emp --filter=@we/we-inv",
    "deploy:worker": "cd workers/api && wrangler deploy",
    "deploy:pages": "turbo run deploy",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:push": "turbo run db:push",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "wrangler": "^3.70.0",
    "@types/node": "^22.0.0"
  },
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=20.0.0"
  }
}